{
  "name": "tour-itinerary-backend",
  "version": "0.0.0",
  "private": true,
  "engines": {
    "node": "24.22.2"
  },
  "packageManager": "npm@11.19.1",
  "scripts": {
    "start:dev": "node --env-file-if-exists=.env node_modules/@nestjs/cli/bin/nest.js start --watch",
    "start:prod": "node --env-file-if-exists=.env dist/main.js",
    "build": "nest build",
    "format:check": "prettier --check .",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "npm run format:check && npm run lint && npm run typecheck && npm test && npm run build",
    "generate": "prisma generate && graphql-codegen --config codegen.ts",
    "prestart:dev": "npm run generate",
    "pretypecheck": "npm run generate",
    "prebuild": "npm run generate",
    "pretest": "npm run generate",
    "db:deploy": "node --env-file-if-exists=.env scripts/database.mjs deploy",
    "db:seed": "node --env-file-if-exists=.env scripts/database.mjs seed",
    "db:dev": "node --env-file-if-exists=.env scripts/database.mjs dev",
    "db:reset": "node --env-file-if-exists=.env scripts/database.mjs reset",
    "precheck": "npm run generate",
    "pretest:watch": "npm run generate",
    "db:shared-deploy": "node scripts/database.mjs shared-deploy",
    "db:shared-seed": "node scripts/database.mjs shared-seed",
    "auth:setup": "node --env-file-if-exists=.env scripts/auth-setup.mjs",
    "auth:register": "node --env-file-if-exists=.env scripts/oidc-client.mjs register",
    "auth:signin": "node --env-file-if-exists=.env scripts/oidc-client.mjs"
  },
  "dependencies": {
    "@apollo/server": "5.5.1",
    "@as-integrations/express5": "1.1.2",
    "@better-auth/oauth-provider": "1.7.18",
    "@nestjs/apollo": "14.2.0",
    "@nestjs/authentication": "0.1.4",
    "@nestjs/common": "12.3.2",
    "@nestjs/core": "12.3.2",
    "@nestjs/graphql": "14.2.0",
    "@nestjs/platform-express": "12.3.2",
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "7.10.1",
    "better-auth": "1.7.18",
    "graphql": "16.15.0",
    "jose": "6.2.15",
    "pg": "8.23.1",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@graphql-codegen/cli": "7.4.6",
    "@graphql-codegen/typescript": "6.1.2",
    "@graphql-codegen/typescript-resolvers": "6.1.1",
    "@nestjs/cli": "12.0.11",
    "@nestjs/testing": "12.3.2",
    "@swc/core": "1.16.20",
    "@types/express": "5.0.6",
    "@types/node": "24.19.2",
    "@types/pg": "8.23.1",
    "eslint": "10.13.0",
    "prettier": "3.9.10",
    "prisma": "7.10.1",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.1",
    "unplugin-swc": "2.0.0",
    "vite": "8.3.5",
    "vitest": "5.0.5"
  }
}
