generator client {
  provider = "prisma-client"
  output = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

model InfrastructureFixture {
  key String @id
  message String
  @@map("infrastructure_fixture")
}

model User {
  id String @id
  name String
  email String @unique
  emailVerified Boolean @default(false)
  image String?
  createdAt DateTime
  updatedAt DateTime
  firstName String
  lastName String
  preferredName String?
  session_userId Session[] @relation("session_userId")
  account_userId Account[] @relation("account_userId")
  oauthClient_userId OauthClient[] @relation("oauthClient_userId")
  oauthRefreshToken_userId OauthRefreshToken[] @relation("oauthRefreshToken_userId")
  oauthAccessToken_userId OauthAccessToken[] @relation("oauthAccessToken_userId")
  oauthConsent_userId OauthConsent[] @relation("oauthConsent_userId")
  @@map("auth_user")
}

model Session {
  id String @id
  expiresAt DateTime
  token String @unique
  createdAt DateTime
  updatedAt DateTime
  ipAddress String?
  userAgent String?
  userId String
  userIdRelation User @relation("session_userId", fields: [userId], references: [id], onDelete: Cascade)
  @@index([userId])
  oauthRefreshToken_sessionId OauthRefreshToken[] @relation("oauthRefreshToken_sessionId")
  oauthAccessToken_sessionId OauthAccessToken[] @relation("oauthAccessToken_sessionId")
  @@map("auth_session")
}

model Account {
  id String @id
  accountId String
  providerId String
  userId String
  userIdRelation User @relation("account_userId", fields: [userId], references: [id], onDelete: Cascade)
  @@index([userId])
  accessToken String?
  refreshToken String?
  idToken String?
  accessTokenExpiresAt DateTime?
  refreshTokenExpiresAt DateTime?
  scope String?
  password String?
  createdAt DateTime
  updatedAt DateTime
  @@map("auth_account")
}

model Verification {
  id String @id
  identifier String
  @@index([identifier])
  value String
  expiresAt DateTime
  createdAt DateTime
  updatedAt DateTime
  @@map("auth_verification")
}

model Jwks {
  id String @id
  publicKey String
  privateKey String
  createdAt DateTime
  expiresAt DateTime?
  alg String?
  crv String?
  @@map("auth_jwks")
}

model OauthClient {
  id String @id
  clientId String @unique
  clientSecret String?
  clientDiscoveryId String?
  disabled Boolean? @default(false)
  skipConsent Boolean?
  enableEndSession Boolean?
  subjectType String?
  scopes String[]
  clientCredentialsScopes String[]
  userId String?
  userIdRelation User? @relation("oauthClient_userId", fields: [userId], references: [id], onDelete: Cascade)
  @@index([userId])
  createdAt DateTime?
  updatedAt DateTime?
  name String?
  uri String?
  icon String?
  contacts String[]
  tos String?
  policy String?
  softwareId String?
  softwareVersion String?
  softwareStatement String?
  redirectUris String[]
  postLogoutRedirectUris String[]
  backchannelLogoutUri String?
  backchannelLogoutSessionRequired Boolean?
  tokenEndpointAuthMethod String?
  applicationType String?
  jwks String?
  jwksUri String?
  grantTypes String[]
  responseTypes String[]
  requirePKCE Boolean?
  dpopBoundAccessTokens Boolean? @default(false)
  referenceId String?
  metadata Json?
  oauthClientResource_clientId OauthClientResource[] @relation("oauthClientResource_clientId")
  oauthRefreshToken_clientId OauthRefreshToken[] @relation("oauthRefreshToken_clientId")
  oauthAccessToken_clientId OauthAccessToken[] @relation("oauthAccessToken_clientId")
  oauthConsent_clientId OauthConsent[] @relation("oauthConsent_clientId")
  @@map("auth_oauthClient")
}

model OauthResource {
  id String @id
  identifier String @unique
  name String
  accessTokenTtl Int?
  refreshTokenTtl Int?
  signingAlgorithm String?
  signingKeyId String?
  allowedScopes String[]
  customClaims Json?
  dpopBoundAccessTokensRequired Boolean? @default(false)
  disabled Boolean? @default(false)
  createdAt DateTime?
  updatedAt DateTime?
  policyVersion Int? @default(1)
  metadata Json?
  oauthClientResource_resourceId OauthClientResource[] @relation("oauthClientResource_resourceId")
  @@map("auth_oauthResource")
}

model OauthClientResource {
  id String @id
  clientId String
  clientIdRelation OauthClient @relation("oauthClientResource_clientId", fields: [clientId], references: [clientId], onDelete: Cascade)
  @@index([clientId])
  resourceId String
  resourceIdRelation OauthResource @relation("oauthClientResource_resourceId", fields: [resourceId], references: [identifier], onDelete: Cascade)
  @@index([resourceId])
  metadata Json?
  createdAt DateTime?
  @@unique([clientId, resourceId])
  @@map("auth_oauthClientResource")
}

model OauthRefreshToken {
  id String @id
  token String @unique
  clientId String
  clientIdRelation OauthClient @relation("oauthRefreshToken_clientId", fields: [clientId], references: [clientId], onDelete: Cascade)
  @@index([clientId])
  sessionId String?
  sessionIdRelation Session? @relation("oauthRefreshToken_sessionId", fields: [sessionId], references: [id], onDelete: Cascade)
  @@index([sessionId])
  userId String
  userIdRelation User @relation("oauthRefreshToken_userId", fields: [userId], references: [id], onDelete: Cascade)
  @@index([userId])
  referenceId String?
  authorizationCodeId String?
  @@index([authorizationCodeId])
  resources String[]
  requestedUserInfoClaims String[]
  expiresAt DateTime?
  createdAt DateTime?
  revoked DateTime?
  rotatedAt DateTime?
  rotationReplayResponse String?
  rotationReplayExpiresAt DateTime?
  authTime DateTime?
  confirmation Json?
  scopes String[]
  oauthAccessToken_refreshId OauthAccessToken[] @relation("oauthAccessToken_refreshId")
  @@map("auth_oauthRefreshToken")
}

model OauthAccessToken {
  id String @id
  token String? @unique
  clientId String
  clientIdRelation OauthClient @relation("oauthAccessToken_clientId", fields: [clientId], references: [clientId], onDelete: Cascade)
  @@index([clientId])
  sessionId String?
  sessionIdRelation Session? @relation("oauthAccessToken_sessionId", fields: [sessionId], references: [id], onDelete: Cascade)
  @@index([sessionId])
  userId String?
  userIdRelation User? @relation("oauthAccessToken_userId", fields: [userId], references: [id], onDelete: Cascade)
  @@index([userId])
  referenceId String?
  authorizationCodeId String?
  @@index([authorizationCodeId])
  resources String[]
  requestedUserInfoClaims String[]
  refreshId String?
  refreshIdRelation OauthRefreshToken? @relation("oauthAccessToken_refreshId", fields: [refreshId], references: [id], onDelete: Cascade)
  @@index([refreshId])
  expiresAt DateTime?
  createdAt DateTime?
  revoked DateTime?
  confirmation Json?
  scopes String[]
  @@map("auth_oauthAccessToken")
}

model OauthConsent {
  id String @id
  clientId String
  clientIdRelation OauthClient @relation("oauthConsent_clientId", fields: [clientId], references: [clientId], onDelete: Cascade)
  @@index([clientId])
  userId String?
  userIdRelation User? @relation("oauthConsent_userId", fields: [userId], references: [id], onDelete: Cascade)
  @@index([userId])
  referenceId String?
  resources String[]
  requestedUserInfoClaims String[]
  scopes String[]
  createdAt DateTime?
  updatedAt DateTime?
  @@map("auth_oauthConsent")
}

model OauthClientAssertion {
  id String @id
  expiresAt DateTime
  @@map("auth_oauthClientAssertion")
}

model ApplicationUser {
 id String @id @default(uuid())
 email String
 firstName String
 lastName String
 preferredName String?
 identities ProviderIdentity[]
 @@map("application_user")
}
model ProviderIdentity {
 id String @id @default(uuid())
 issuer String
 subject String
 userId String
 user ApplicationUser @relation(fields: [userId], references: [id], onDelete: Restrict)
 @@unique([issuer, subject])
 @@index([userId])
 @@map("provider_identity")
}
