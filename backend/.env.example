# Optional for local development; defaults are shown here.
NODE_ENV=development
PORT=3000

# Production requires the full 40-character lowercase source Git SHA.
# The delivery toolchain supplies it; "local" is only for development/tests.
COMMIT_SHA=local

# Set true to enable the browser query editor at /graphql; restart after changing.
GRAPHQL_PLAYGROUND=false

# Local Docker Compose only. Never reuse these disposable credentials remotely.
# Runtime is SELECT-only; the health-only app does not consume this setting yet.
DATABASE_URL=postgresql://it_runtime:local-runtime@127.0.0.1:5432/it_local
MIGRATION_DATABASE_URL=postgresql://it_migration:local-migration@127.0.0.1:5432/it_local
SHADOW_DATABASE_URL=postgresql://it_migration:local-migration@127.0.0.1:5432/it_shadow
# Test provisioner creates/drops only uniquely named it_test_<pid> databases.
TEST_ADMIN_DATABASE_URL=postgresql://it_admin:local-admin@127.0.0.1:5432/it_admin
